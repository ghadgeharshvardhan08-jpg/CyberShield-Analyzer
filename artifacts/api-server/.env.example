# Copy to .env for local development. Use a unique random value for real deployments.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Use PostgreSQL for durable data. If omitted, local development uses SQLite.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cybershield

# Set true behind HTTPS in production; false for plain HTTP localhost.
COOKIE_SECURE=false
ENVIRONMENT=development

# Optional comma-separated browser origins for a separately hosted frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
